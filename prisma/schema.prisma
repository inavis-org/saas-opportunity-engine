generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  analyses  Analysis[]
}

model Competitor {
  id        String     @id @default(cuid())
  name      String
  website   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  analyses  Analysis[]
}

model Analysis {
  id                String      @id @default(cuid())
  title             String
  status            String      @default("draft")
  summary           String?
  opportunityScore  Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  competitorId      String?
  competitor        Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  reviews           Review[]
  insights          Insight[]
}

model Review {
  id          String    @id @default(cuid())
  source      String    @default("paste")
  externalId  String?
  content     String
  rating      Int?
  author      String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  analysisId  String
  analysis    Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model Insight {
  id            String   @id @default(cuid())
  kind          String
  title         String
  description   String?
  frequency     Float?
  evidenceCount Int      @default(0)
  evidence      Json?
  createdAt     DateTime @default(now())
  analysisId    String
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}
